JWT_EXPIRATION_HOURS=24
ALLOWED_ORIGINS=http://hancens.top:50001,https://hancens.top:50001,http://hancens.top,https://hancens.top

# ====================
# 网络代理配置
# ====================
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# ====================
# MongoDB配置（本地连接）
# ====================
MONGODB_URL=mongodb://guanshan:5iSFspPkCLG5cRiD@127.0.0.1:40717/?authSource=guanshan
MONGODB_DB_NAME=guanshan
MONGODB_MAX_POOL_SIZE=100
