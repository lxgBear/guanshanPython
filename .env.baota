# ====================
# 应用基础配置
# ====================
APP_NAME="Guanshan Intelligence System"
VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

# ====================
# 测试模式配置
# ====================
TEST_MODE=false
TEST_MAX_RESULTS=10
