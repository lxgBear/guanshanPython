client
dev tun
proto udp
remote hancens.top

resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-128-GCM
ignore-unknown-option block-outside-dns block-ipv6
verb 3
route-nopull
route 192.168.0.0 255.255.255.0
route 10.0.0.0 255.0.0.0
pull-filter ignore dhcp-option
